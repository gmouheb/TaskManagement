{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Serene Interval",
  "version": "0.1.0",
  "identifier": "com.sereneinterval.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Serene Interval",
        "width": 1200,
        "height": 780,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "category": "Productivity",
    "shortDescription": "A calm Pomodoro focus timer.",
    "longDescription": "Serene Interval is a simple desktop Pomodoro timer for focus sessions, short breaks, long breaks, local task tracking, and local session history."
  }
}
